class Hissi:
    def __init__(self, alin_kerros, ylin_kerros):
        self.alin = alin_kerros
        self.ylin = ylin_kerros
        self.kerros = alin_kerros


    def kerros_ylos(self):
        if self.kerros < self.ylin:
            self.kerros += 1
        print(f"Hissi on nyt {self.kerros} kerroksessa.")

    def kerros_alas(self):
        if self.kerros > self.alin:
            self.kerros -= 1
        print(f"Hissi on nyt {self.kerros} kerroksessa.")

    def siirry_kerrokseen(self, kohde):
        if kohde < self.alin or kohde > self.ylin:
            print(f"Kerros {kohde} ei ole olemassa.")
            return

        while self.kerros < kohde:
            self.kerros_ylos()

        while self.kerros > kohde:
            self.kerros_alas()



if __name__ == "__main__":
    hissi = Hissi(1, 10)
    hissi.siirry_kerrokseen(5)

    print("Siirrytään takaisin alimpaan kerrokseen.")
    hissi.siirry_kerrokseen(hissi.alin)
    print(f"Hissi on nyt alimmassa kerroksessa")
