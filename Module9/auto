import random

class Auto:

    def __init__(self, rekisteritunnus, huippunopeus):
        self.rekisteritunnus = rekisteritunnus
        self.huippunopeus = huippunopeus
        self.nopeus = 0
        self.matka = 0

    def kiihdyta(self, muutos):
        self.nopeus += muutos

        if self.nopeus > self.huippunopeus:
            self.nopeus = self.huippunopeus

        if self.nopeus < 0:
            self.nopeus = 0

    def kulje(self, aika):
        self.matka += aika * self.nopeus

autot = []

def uudet_autot():
    for i in range(1, 11): 
        autorand = Auto(f"ABC-{i}", random.randint(100, 200))
        autot.append(autorand)


uudet_autot()

while True:
    for auto in autot:
        arvottu_muutos = random.randint(-10, 15)
        auto.kiihdyta(arvottu_muutos)
        auto.kulje(1)
    
    if auto.matka >= 100000:
        break


print(f"{'Rekisteri':<12} | {'Huippunopeus':<15} | {'Nopeus':<10} | {'Matka (km)':<12}")
print("-" * 60)
for auto in autot:
    print(f"{auto.rekisteritunnus:<12} | {auto.huippunopeus:<15} | {auto.nopeus:<10} | {auto.matka:<12.1f}")
