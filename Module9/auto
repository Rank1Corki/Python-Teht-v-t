import random

class Auto:
    def __init__(self, rekisteritunnus, huippunopeus):
        self.rekisteritunnus = rekisteritunnus
        self.huippunopeus = huippunopeus
        self.nopeus = 1
        self.matka = 0
        self.aika = 0 

    def kiihdyta(self, muutos):
        self.nopeus += muutos
        if self.nopeus > self.huippunopeus:
            self.nopeus = self.huippunopeus
        if self.nopeus < 0:
            self.nopeus = 1

    def kulje(self, aika):
        self.matka += aika * self.nopeus


class Kilpailu:
    auto = Auto
    def __init__(self, kilpailun_nimi, pituus_km):
        self.kilpailun_nimi = kilpailun_nimi
        self.pituus_km = pituus_km
        self.autot = []

    def tunti_kuluu(self):
        for auto in self.autot:
            rando = random.randint(-10, 15)
            auto.kiihdyta(rando)
            auto.kulje(1)




his = Kilpailu("Pitkä kilpailu", 8000)

def uudet_autot():
    for i in range(1, 11): 
        autorand = Auto(f"ABC-{i}", random.randint(100, 200))
        his.autot.append(autorand)

uudet_autot()

eka_maalissa = False

while not eka_maalissa:
    
    his.tunti_kuluu()

    for auto in his.autot:
        auto.aika += 1

    
    for auto in his.autot:
        if auto.matka >= his.pituus_km:
           eka_maalissa = True

    
    if auto.matka >= his.pituus_km:
        eka_maalissa = True
        break


his.autot.sort(key=lambda x: x.matka, reverse=True)

