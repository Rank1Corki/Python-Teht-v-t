import random

class Auto:
    def __init__(self, rekisteritunnus, huippunopeus):
        self.rekisteritunnus = rekisteritunnus
        self.huippunopeus = huippunopeus
        self.nopeus = 0
        self.matka = 0
        self.aika = 0 

    def kiihdyta(self, muutos):
        self.nopeus += muutos
        if self.nopeus > self.huippunopeus:
            self.nopeus = self.huippunopeus
        if self.nopeus < 0:
            self.nopeus = 0

    def kulje(self, aika):
        self.matka += aika * self.nopeus

autot = []

def uudet_autot():
    for i in range(1, 11): 
        autorand = Auto(f"ABC-{i}", random.randint(100, 200))
        autot.append(autorand)

uudet_autot()

while True:
    kaikki_maalissa = True  
    
    for auto in autot:
        if auto.matka < 10000:
            kaikki_maalissa = False 
            arvottu_muutos = random.randint(-10, 15)
            auto.kiihdyta(arvottu_muutos)
            auto.kulje(1)
            auto.aika += 1 
            
    if kaikki_maalissa:
        break


autot.sort(key=lambda x: x.aika)


print(f"{'Sija':<5} | {'Rekisteri':<10} | {'Huippunopeus':<13} | {'Aika (h)':<8} | {'Matka (km)':<10}")
print("-" * 60)
for sijoitus, auto in enumerate(autot, 1):
    print(f"{sijoitus:<5} | {auto.rekisteritunnus:<10} | {auto.huippunopeus:<13} | {auto.aika:<8} | {auto.matka:<10.1f}")
